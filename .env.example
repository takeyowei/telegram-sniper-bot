# Copy this file to ".env" and fill in your real token.
# Get the token from @BotFather on Telegram (see README.md).
BOT_TOKEN=<redacted>

# Optional: paper starting balance in paper SOL (default: 100.0).
# PAPER_START_SOL=100.0

# There is deliberately NO setting for a wallet, private key, RPC URL or
# mainnet flag in this project: paper trading is the only mode.
